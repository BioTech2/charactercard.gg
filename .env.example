# CharacterCard.gg works with Raider.IO public character data by default.

# Optional: enables official Blizzard profile data for item level, faction,
# guild, and full character render media.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=

# Optional: enables Warcraft Logs parse averages, rankings, and raid summaries.
# WARCRAFTLOGS_CLIENT_ID=
# WARCRAFTLOGS_CLIENT_SECRET=
